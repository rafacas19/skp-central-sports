# ─── Telegram ───────────────────────────────────────────────
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=put-your-bot-token-here

# ─── AI providers ───────────────────────────────────────────
# When true, the bot uses deterministic mock AI and needs NO API keys.
# Set to false and fill the keys below to go live.
USE_MOCK_AI=true

# Claude — used for lineup-image (vision) parsing + note classification
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI Whisper — used for voice-note transcription
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ─── Storage (Postgres) ─────────────────────────────────────
# libpq connection URL. Render injects this automatically from its managed
# Postgres (see render.yaml). Locally, run a Postgres and point here, e.g.:
#   postgresql://scouting:scouting@localhost:5432/scouting
DATABASE_URL=

# ─── Behaviour ──────────────────────────────────────────────
# Confidence threshold (0-1) below which the bot asks the agent to confirm
CONFIDENCE_THRESHOLD=0.65

# Minutes of inactivity before the bot nudges "still scouting?"
SESSION_NUDGE_MINUTES=120

# ─── Web service / webhook (production) ─────────────────────
# Leave WEBHOOK_BASE_URL empty for local development → the bot long-polls
# (no public URL needed). Set it to your public https URL to run in webhook
# mode as a web service. On Render this is your service's external URL, e.g.
#   https://skp-central-sports.onrender.com
WEBHOOK_BASE_URL=

# Optional shared secret Telegram echoes back on every webhook call; the bot
# rejects calls without it. Generate a random string. Render can auto-generate.
WEBHOOK_SECRET=

# Port the web service binds to. Render sets PORT automatically; default 10000.
PORT=10000
